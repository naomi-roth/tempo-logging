{
  // --- Required ---------------------------------------------------------------------------------

  // Jira where worklogs are uploaded (the one Tempo reads)
  "jira_url": "https://jira.<DOMAIN>",

  // The codes you type at the start of a line (BE-2h-fix bug). Case-insensitive, must NOT contain a hyphen.
  // "issueKey" is the Jira issue the time is logged against.
  "tasks": [
    { "code": "BE",  "name": "Backend development", "issueKey": "<ISSUE_KEY>" },
    { "code": "MTG", "name": "Meetings", "issueKey": "<ISSUE_KEY>" }
  ],

  // --- Optional: everything below has a default ---------------------------------------------------
  // hotkey to replace Default: win+shift+w
  // "hotkey": "ctrl+alt+j",

  // When the first entry of a day starts. Later entries are stacked after it. Default: "09:00"
  // "day_start": "09:00",

  // Hours you aim to log per weekday. Default: 8
  // "target_hours": 8,

  // Longest entry you can type, in hours. -1 means no limit. Imported meetings are exempt. Default: 4
  // "max_entry_hours": 4,

  // Weekday time (HH:MM) for the tray nudge when you are under target. "" turns it off. Default: "15:00"
  // "reminder_time": "15:00",

  // Calendar feed: an ICS link or a file path. Needed for the Meetings button and for absences.
  // Outlook on the web > Settings > Calendar > Shared calendars > Publish a calendar > ICS link.
  // SECRET: anyone with the link can read your calendar. Keep it only in this git-ignored file.
  "calendar_ics": "https://<PUBLISHED_CALENDAR_LINK>.ics",

  // Whether to show the Meetings button (imports accepted meetings from the feed, past or upcoming). Default: true
  // "import_meetings_from_outlook": true,

  // Task code used for imported meetings. Must be one of the codes above. Default: "MTG"
  // "meeting_code": "MTG",

  // Regex (case-insensitive) on an event subject that marks it as an absence, not a meeting.
  // Events with the busy status "Out of office" always count. Default:
  // "absence_match": "absence|out of office|\\booo\\b|vacation|holiday|sick",

  // Whether to read absences (out of office, and holidays matching absence_match) from the feed. They show greyed out and lower
  // that day's target. Read on startup for the next month, and by the Meetings button. Default: true
  // "import_absences_from_outlook": true,

  // Parallel uploads when syncing. Default: 4
  // "workers": 4,

  // Environment variable that may hold the upload session cookie instead of cookie.txt. Default: "JIRA_COOKIE"
  // "cookie_env": "JIRA_COOKIE",

  // Read-only Jira: lists your in-progress tickets in the widget. Click one to fill "BE -  - <title>".
  // Remove this whole block to hide the ticket list.
  "tickets": {
    // Base URL of that Jira, including a context path such as /jira. Required in this block.
    "url": "https://<OTHER_JIRA_DOMAIN>/jira",

    // Personal access token: avatar > Profile > Personal Access Tokens > Create token. Read access is enough.
    // Required in this block. Never commit it or paste it into chat.
    "token": "<READ_TOKEN>"

    // Task code put at the start of the filled line. Must be one of the codes above. Default: "BE"
    // , "code": "BE"

    // JQL for the list. Default: my tickets whose status category is In Progress, newest update first.
    // , "jql": "assignee = currentUser() AND statusCategory = 'In Progress' ORDER BY updated DESC"
  }
}
